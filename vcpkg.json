{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "briskplayer",
  "version": "3.0.3",
  "builtin-baseline": "77df67cfff9c12ccfdb52284e07c87c75092f723",
  "dependencies": [
    "zlib",
    "faudio",
    "fdk-aac",
    {
      "name": "opusfile",
      "default-features": false
    },
    "gettext-libintl",
    {
      "name": "gettext",
      "host": true,
      "features": [
        "tools"
      ]
    }
  ],
  "features": {
    "discord-rpc": {
      "description": "Discord Rich Presence integration (shows Now Playing in Discord)",
      "dependencies": [
        "discord-rpc"
      ]
    }
  },
  "default-features": [
    "discord-rpc"
  ]
}
