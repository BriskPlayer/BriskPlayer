    CONTROL         "Allow file once in playlist",IDC_FILEONCE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,67,180,10
    CONTROL         "Autoplay on startup",IDC_AUTOPLAY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,80,180,10
