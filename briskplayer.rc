IDR_MENU1 MENU
BEGIN
    POPUP "Nothing here"
    BEGIN
        MENUITEM "&Open...\tL",                 MENU_OPENFILE
        MENUITEM "Open &URL...",                MENU_OPENLOC
        MENUITEM "&Add...\tA",                  MENU_ADDFILE
        MENUITEM SEPARATOR
        MENUITEM "Playlist &Editor\tP",         MENU_PLAYLIST
        POPUP "&Skin"
        BEGIN
            MENUITEM "Default",                     MENU_SKIN_DEFAULT
        END
        POPUP "&Language"
        BEGIN
            MENUITEM "English",                     MENU_LANGUAGE_EN
            MENUITEM "Deutsch",                     MENU_LANGUAGE_DE
        END
        POPUP "&DSP Plugins"
        BEGIN
            MENUITEM "None (Disabled)",             MENU_DSP_NONE
        END
        POPUP "&Equalizer"
        BEGIN
            MENUITEM "Flat",                        MENU_EQ_PRESET_FLAT
            MENUITEM "Bass Boost",                  MENU_EQ_PRESET_BASS_BOOST
            MENUITEM "Treble Boost",                MENU_EQ_PRESET_TREBLE_BOOST
            MENUITEM "Rock",                        MENU_EQ_PRESET_ROCK
            MENUITEM "Classical",                   MENU_EQ_PRESET_CLASSICAL
            MENUITEM "Pop",                         MENU_EQ_PRESET_POP
            MENUITEM "Jazz",                        MENU_EQ_PRESET_JAZZ
            MENUITEM "Dance",                       MENU_EQ_PRESET_DANCE
        END
        MENUITEM SEPARATOR
        POPUP "Play &Control"
        BEGIN
            MENUITEM "&Play\tX",                    ID_PLAY
            MENUITEM "&Stop\tV",                    ID_STOP
            MENUITEM "Pa&use\tC",                   ID_PAUSE
            MENUITEM "&Next\tB",                    ID_NEXT
            MENUITEM "Pre&vious\tZ",                ID_PREVIOUS
        END
        MENUITEM SEPARATOR
        MENUITEM "O&ptions",                    MENU_OPTIONS
        MENUITEM SEPARATOR
        MENUITEM "A&bout...\tF1",               MENU_ABOUT
        MENUITEM "E&xit...\tESC",               MENU_EXIT
    END
END


