    CONTROL         "Read ID3 Tag (if any)",IDC_READTAG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,210,15,190,10
    CONTROL         "Read ID3 Tag of selected",IDC_READSELTAG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,210,28,190,10
    CONTROL         "Support ID3v2",IDC_SUPPORTID3_V2,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,210,41,190,10
    CONTROL         "Prefer native OGG tags",IDC_PREFERNATIVEOGGTAGS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,210,54,190,10
    CONTROL         "Load ID3 tags in background ",IDC_READID3INBACKGROUND,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,210,67,190,10
    CONTROL         "Work out track lengths",IDC_READTRACKTIME,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,210,80,190,10
    CONTROL         "Easy move",IDC_EASYMOVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,210,93,190,10
    CONTROL         "Remember playlist",IDC_REMEMBERPLS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,210,106,190,10
    CONTROL         "Remember last played",IDC_REMSONG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,210,119,190,10
    EDITTEXT        IDC_DELAYTIME,210,138,24,15,ES_AUTOHSCROLL | ES_READONLY | ES_NUMBER
    CONTROL         "Spin1",IDC_DELAYTIMES,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,230,137,11,9
    LTEXT           "Track Delay (sec)",-1,245,140,80,8
    EDITTEXT        IDC_REMSKINVAL,210,156,23,15,ES_AUTOHSCROLL | ES_READONLY | ES_NUMBER
    CONTROL         "Spin1",IDC_REMEMBERSKIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,230,158,11,9
    LTEXT           "Skinlist length",-1,245,158,80,11
    PUSHBUTTON      "Flush",IDC_FLUSH_SKINLIST,330,156,40,15
    GROUPBOX        "Output",-1,7,195,406,55
    COMBOBOX        IDC_OUTPUT,15,206,390,81,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Volume controls",-1,15,225,80,12,SS_CENTERIMAGE
    COMBOBOX        IDC_MIXER,100,225,305,81,CBS_DROPDOWNLIST | WS_TABSTOP
    GROUPBOX        "Skin",-1,7,258,406,40,WS_GROUP
    CONTROL         "Player",IDC_PLAYERSKINCHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,273,50,10
    EDITTEXT        IDC_LOADSKIN,70,271,275,15,ES_AUTOHSCROLL | ES_READONLY
