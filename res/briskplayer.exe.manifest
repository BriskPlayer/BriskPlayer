  <asmv3:application xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
    <asmv3:windowsSettings
         xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings"
         xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <!-- Per-Monitor DPI Awareness v2 (Windows 10 1703+), falls back to system DPI aware -->
      <dpiAware>true/pm</dpiAware>
      <ws2:dpiAwareness>PerMonitorV2, PerMonitor, system</ws2:dpiAwareness>
      <!-- Enable long path support (Windows 10 1607+) -->
      <ws2:longPathAware>true</ws2:longPathAware>
      <!-- Use UTF-8 as process code page (Windows 10 1903+) -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </asmv3:windowsSettings>
  </asmv3:application>
